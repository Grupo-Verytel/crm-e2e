# Copy to .env (never commit real values)
DATABASE_URL=mysql://user:pass@localhost:3306/crm_frisson
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
NODE_ENV=development

# Integracion CRM <-> MEP-LEAN (SPEC-CRM-MEPLEAN-001)
MEP_API_ENVIRONMENT=sandbox
MEP_API_KEY_PEPPER=change-me
MEP_CURSOR_SECRET=change-me
MEP_REQUIRE_HTTPS=true

# Semaphore window in America/Bogota calendar days (integer >= 0, default 2).
FOLLOW_UP_YELLOW_DAYS=2

# Outlook sync for OUV reminders. Default off: the job does not start.
# true or false. Any other value prevents boot.
OUTLOOK_SYNC_ENABLED=false
# Integer >= 1. Empty uses 5. Invalid prevents boot.
OUTLOOK_SYNC_MAX_ATTEMPTS=5
# Integer milliseconds >= 1000. Empty uses 60000. Invalid prevents boot.
OUTLOOK_SYNC_INTERVAL_MS=60000
# Public frontend origin for the event link. Required only when the flag is true.
CRM_PUBLIC_URL=http://localhost:5173
